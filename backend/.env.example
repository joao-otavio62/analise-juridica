# Copie para .env.local / .env.dev / .env.prod (esses arquivos NÃO vão para o git).
# O arquivo carregado é escolhido por DJANGO_ENV (padrão: local).

SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite por padrão. Em produção: postgres://usuario:senha@host:5432/banco
# DATABASE_URL=postgres://usuario:senha@localhost:5432/analise_juridica

# Usuário mockado (admin/admin) — somente dev/local
SEED_ADMIN=True
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin

# Swagger em /api/docs público? (False em produção)
DOCS_PUBLIC=True

# IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_SUMMARY_MAX_TOKENS=1500
GEMINI_CHAT_MAX_TOKENS=800
# GEMINI_THINKING_BUDGET=0

# Limites
MAX_UPLOAD_MB=100
MAX_TEXT_CHARS=100000
CHAT_HISTORY_LIMIT=6
THROTTLE_UPLOAD=5/hour
THROTTLE_CHAT=30/hour
THROTTLE_AUTH=30/min
